{
  "type": "object",
  "required": [
    "id",
    "family",
    "title",
    "definition",
    "evidenceNeeded",
    "firstIntervention",
    "pairedOvercorrection",
    "routes",
    "familyCauseCandidates",
    "causeStatus",
    "noActionRule",
    "automaticRejection"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "definition": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "evidenceNeeded": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "firstIntervention": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "pairedOvercorrection": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      },
      "maxItems": 256
    },
    "familyCauseCandidates": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CF[1-8]$"
      },
      "minItems": 1,
      "maxItems": 8
    },
    "causeStatus": {
      "type": "string",
      "const": "hypotheses_not_observed_causes"
    },
    "noActionRule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "automaticRejection": {
      "type": "boolean",
      "const": false
    }
  },
  "additionalProperties": false
}
