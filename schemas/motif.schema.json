{
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "materialForms",
    "thematicQuestions",
    "initialMeaning",
    "viewpointMeanings",
    "transformations",
    "forbiddenGlosses",
    "when",
    "dependencies",
    "saturation",
    "history"
  ],
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "materialForms": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      },
      "maxItems": 256
    },
    "thematicQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      },
      "maxItems": 256
    },
    "initialMeaning": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "viewpointMeanings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "holderId",
          "meaning"
        ],
        "properties": {
          "holderId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "transformations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      },
      "maxItems": 256
    },
    "forbiddenGlosses": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20000
      },
      "maxItems": 256
    },
    "when": {
      "type": "object",
      "required": [
        "focalizerIds",
        "sceneFunctions",
        "epochIds",
        "pressures",
        "distances"
      ],
      "properties": {
        "focalizerIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "maxItems": 100
        },
        "sceneFunctions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          },
          "maxItems": 256
        },
        "epochIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "maxItems": 100
        },
        "pressures": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          },
          "maxItems": 256
        },
        "distances": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          },
          "maxItems": 256
        }
      },
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "hash"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      },
      "maxItems": 2000
    },
    "saturation": {
      "type": "object",
      "required": [
        "windowWords",
        "warningCount",
        "basis",
        "evidence"
      ],
      "properties": {
        "windowWords": {
          "type": "integer",
          "minimum": 1
        },
        "warningCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "enum": [
            "unconfigured",
            "design_heuristic",
            "human_calibrated"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "key",
              "hash"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}:[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          },
          "maxItems": 2000
        }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "position",
          "rationale",
          "evidence",
          "meaning",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "position": {
            "type": "object",
            "required": [
              "sceneId",
              "narrativeIndex",
              "wordPosition",
              "ordinal"
            ],
            "properties": {
              "sceneId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "narrativeIndex": {
                "type": "integer",
                "minimum": 0
              },
              "wordPosition": {
                "type": "integer",
                "minimum": 0
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sceneId",
                "textHash",
                "start",
                "end",
                "quote",
                "offsetUnit"
              ],
              "properties": {
                "sceneId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "textHash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "offsetUnit": {
                  "type": "string",
                  "const": "utf16"
                }
              },
              "additionalProperties": false
            },
            "maxItems": 100
          },
          "meaning": {
            "type": "string",
            "maxLength": 20000
          },
          "action": {
            "enum": [
              "introduce",
              "recur",
              "transform",
              "omit",
              "dormant",
              "retire",
              "reactivate"
            ]
          }
        },
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "additionalProperties": false
}
