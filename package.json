{
  "name": "@sonny/pi-novel-writer",
  "version": "0.2.2",
  "type": "module",
  "description": "Autonomous, evidence-led novel writing for Pi",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": [
      "./extensions/novel-core.ts",
      "./extensions/novel-bible.ts",
      "./extensions/novel-write.ts",
      "./extensions/novel-edit.ts",
      "./extensions/novel-export.ts",
      "./extensions/novel-progress.ts",
      "./extensions/novel-github.ts",
      "./extensions/novel-auto.ts"
    ],
    "skills": [
      "./skills/autonomous-novel",
      "./skills/getting-started",
      "./skills/import",
      "./skills/premise",
      "./skills/world-building",
      "./skills/character-interview",
      "./skills/retroactive-outline",
      "./skills/outline-novel",
      "./skills/outline-chapter",
      "./skills/draft-scene",
      "./skills/dev-edit",
      "./skills/line-edit",
      "./skills/copy-edit",
      "./skills/continuity-check",
      "./skills/voice-match",
      "./skills/github-setup"
    ],
    "prompts": ["./prompts"],
    "themes": ["./themes"]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  }
}
